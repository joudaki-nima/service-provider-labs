hostname CSC-PE7
!
interface Loopback0
 ip address 7.7.7.7 255.255.255.255
 ip router isis 
!
interface GigabitEthernet0/0
 ip address 10.7.8.7 255.255.255.0
!
interface GigabitEthernet0/1
 ip address 10.6.7.7 255.255.255.0
 ip router isis 
!
router isis
 net 49.0001.0000.0000.0007.00
